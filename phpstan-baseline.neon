parameters:
	ignoreErrors:
		-
			message: '#^Access to an undefined property PhpParser\\Node\\Arg\|PhpParser\\Node\\ArgPlaceholder\|PhpParser\\Node\\VariadicPlaceholder\:\:\$name\.$#'
			identifier: property.notFound
			count: 1
			path: src/NodeCompiler/CompileNodeToValue.php

		-
			message: '#^Access to an undefined property PhpParser\\Node\\Arg\|PhpParser\\Node\\ArgPlaceholder\|PhpParser\\Node\\VariadicPlaceholder\:\:\$value\.$#'
