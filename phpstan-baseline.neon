			count: 1
			path: src/NodeCompiler/CompileNodeToValue.php

		-
			message: '#^Method PHPStan\\BetterReflection\\NodeCompiler\\CompilerContext\:\:getFileName\(\) should return non\-empty\-string\|null but returns string\.$#'
