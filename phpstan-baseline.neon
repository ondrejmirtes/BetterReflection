			count: 1
			path: src/NodeCompiler/CompilerContext.php

		-
			message: '#^Comparison operation "\<" between int\<80400, 80699\> and 80012 is always false\.$#'
			identifier: smaller.alwaysFalse
			count: 1
			path: src/Reflection/Adapter/ReflectionAttributeFactory.php

		-
			message: '#^Comparison operation "\>\=" between int\<80400, 80699\> and 80000 is always true\.$#'
